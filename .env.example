# ============================================================================
# BACAXITA HEADSHOP (frontend) - exemplo de configuração local
# ============================================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# NUNCA commite o arquivo .env real.
# ============================================================================

# URL base da API pública (headshop) servida pelo backend monorepo
VITE_API_URL=http://localhost:5050/api/headshop

# Liga/desliga mocks em memória (usar false em produção)
VITE_ENABLE_MOCKS=false

# Lista separada por vírgula de emails com permissão de admin
VITE_ADMIN_EMAILS=adm.bacaxita@gmail.com

# URL do painel ERP (redirect a partir de /erp)
VITE_ERP_URL=http://localhost:5050/login

# URL base da API ERP (usada como fallback pela camada de API)
VITE_ERP_API_URL=http://localhost:5050/api/erp
